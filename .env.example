# Port der lokalen Mitschrift-API (Standard: 8779)
# API_PORT=8779

# WebUntis-Zugang für den Stundenplan im Kalender.
# Ohne diese Werte zeigt der Kalender nur von Hand angelegte Termine; die
# Untis-Integration lässt sich dann in der Kalender-Ansicht nicht aktivieren.
#
# Einfachster Weg: die komplette QR-Code-URI aus WebUntis
# (Profil -> Freigaben -> Datenzugriff -> "Anzeigen" bei der Login-URL, oder
# den QR-Code mit einem beliebigen Scanner lesen). Sieht so aus:
# UNTIS_QR_URI=untis://setschool?url=SERVER&school=SCHULE&user=NUTZER&key=GEHEIMNIS&schoolNumber=...
#
# Alternativ einzeln (SECRET ist der "key"-Wert aus der QR-URI, kein normales Passwort):
# UNTIS_SCHOOL=meine-schule
# UNTIS_USERNAME=vorname.nachname
# UNTIS_SECRET=geheimnis
# UNTIS_SERVER=herakles.webuntis.com
